import tkinter as tk
from tkinterdnd2 import DND_FILES, TkinterDnD
import time as tm

# Create a TkinterDnD window (required for drag-and-drop)
root = TkinterDnD.Tk()
root.title("Subtitles generator - Drag and Drop File Here")
root.geometry("400x200")

# Variable to hold the file path
dropped_file_path = tk.StringVar()

# Label to display the file path
label = tk.Label(root, text="Drag and drop a file here", bg="lightgrey", width=40, height=5)
label.pack(padx=10, pady=10, expand=False)

# Status message label (bottom)
status_label = tk.Label(root, text="", bg="#f0f0f0", fg="grey", font=("Arial", 10))
status_label.pack(side="bottom", pady=10)

# Function to handle drop event
def drop(event):
    path = event.data.strip("{}")
    dropped_file_path.set(path)
    label.config(text=f"File path:\n{path}")
    print(f"File path captured: {path}")
label.drop_target_register(DND_FILES)
label.dnd_bind('<<Drop>>', drop)


def format_time(seconds):
    hours = int(seconds // 3600)
    seconds = seconds % 3600
    minutes = int(seconds // 60)
    seconds = seconds % 60
    milliseconds = int(round((seconds - int(seconds)) * 1000))
    seconds = int(seconds)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d},{milliseconds:03d}"


def process_file():
    path = dropped_file_path.get()
    
    # Selecting and assigning audio and video paths
    if path:
        print(f"Processing file: {path}")
        import subprocess
        import os
        source = path
        path = os.path.split(source)[0]
        video = source
        audio = video.replace(os.path.splitext(video)[1], ".mp3")
        
        # 1 Audio: Start process to extract audio from video file
        print(f" - Extracting audio (.mp3) from original video file...Please wait...")
        #---
        res = subprocess.call([rf'D:\ffmpeg-2025-06-23\bin\ffmpeg.exe','-i',video,'-map','0:a','-acodec','libmp3lame',audio], shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        #---
        if res == 0:
            print(' - Extracting audio ... [OK]')
        else:
            print(' - Extracting audio failed')


        #Ensure ffmpeg is on PATH so whisper's audio helper can run ffmpeg
        import shutil
        ffmpeg_expected = r'D:\ffmpeg-2025-06-23\bin\ffmpeg.exe'
        if shutil.which('ffmpeg') is None:
            if os.path.exists(ffmpeg_expected):
                #---
                os.environ['PATH'] = os.path.dirname(ffmpeg_expected) + os.pathsep + os.environ.get('PATH','') # añade el path de ffmpeg a los env vas
                #---
                print(f"    + Added {os.path.dirname(ffmpeg_expected)} to PATH for ffmpeg access")
            else:
                print("Warning: ffmpeg not found in PATH and expected location not present. Whisper transcription may fail. Install ffmpeg or update PATH.")
        
        # 2 Texto: Start process to encode and extract text from audio file 
        import whisper
        from whisper.utils import get_writer
        print(' - Loading base model for Whisper Lib...Please wait...')
        model = whisper.load_model('base')
        print(' - Transcribing...Please wait...')
        #---
        result = model.transcribe(audio, fp16=False)
        #---
        
        # Start process of dumping transcription onto file
        print(' - Writing transcription...')
        #---
        sub_writer = get_writer('srt', output_dir=path)
        sub_writer(result, audio)
        #---
        print(' - Done - If you want to trasncribe another video''s text, drag a new video here, otherwise close this window.')
    else:
        print('No file selected')

button = tk.Button(root, text="Process File", command=process_file, bg="#4CAF50", fg="white")
button.pack()

root.mainloop()
